# Cantine Castaldo Tuccillo — variabili d'ambiente (modello, senza valori).
# Copia in .env.local (mai in Git) e, in produzione, nelle variabili del
# servizio di hosting. Dettagli: docs/SHOPIFY.md.

# ── Negozio Shopify (canale Headless) ─────────────────────────────────────
# Dominio permanente .myshopify.com (non il dominio pubblico del sito)
SHOPIFY_STORE_DOMAIN=
# Token PRIVATO Storefront: solo server, preferito. Mai NEXT_PUBLIC_.
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=
# Token pubblico Storefront: usato solo se manca quello privato
SHOPIFY_STOREFRONT_PUBLIC_TOKEN=
# Versione API (facoltativa, predefinita 2026-10)
SHOPIFY_STOREFRONT_API_VERSION=

# ── Collezioni (handle) ───────────────────────────────────────────────────
# Catalogo completo della pagina /vini
SHOPIFY_CATALOG_COLLECTION=vini
# Selezione della homepage (può coincidere con il catalogo)
SHOPIFY_HOME_COLLECTION=vini

# ── Mercato ───────────────────────────────────────────────────────────────
SHOPIFY_COUNTRY=IT
SHOPIFY_LANGUAGE=IT

# ── Aggiornamento dei dati ────────────────────────────────────────────────
# Chiave di firma dei webhook (Impostazioni → Notifiche → Webhook)
SHOPIFY_WEBHOOK_SECRET=
# Segreto per l'aggiornamento manuale (POST /api/shopify/revalidate)
SHOPIFY_REVALIDATE_SECRET=
# Aggiornamento di riserva in secondi (predefinito 900)
SHOPIFY_REVALIDATE_SECONDS=

# ── Modalità ──────────────────────────────────────────────────────────────
# "showcase": vetrina dei vini di lib/content.ts, senza prezzi né carrello.
# Lasciare vuoto quando il negozio è collegato.
COMMERCE_PROVIDER=
